{
  "expo": {
    "name": "SwiftDeliver Courier",
    "slug": "swiftdeliver-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10111a"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
