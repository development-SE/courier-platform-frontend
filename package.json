{
  "name": "courier-platform-mobile",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "native:start": "npm --prefix apps/courier-native start",
    "native:android": "npm --prefix apps/courier-native android",
    "native:ios": "npm --prefix apps/courier-native ios",
    "native:typecheck": "npm --prefix apps/courier-native run typecheck",
    "user:start": "npm --prefix apps/user start",
    "user:android": "npm --prefix apps/user android",
    "user:ios": "npm --prefix apps/user ios",
    "user:typecheck": "npm --prefix apps/user run typecheck"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^4.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^6.3.5"
  }
}
